FROM node:22-alpine

RUN apk add --no-cache python3 py3-pip git ripgrep
RUN npm install --global @openai/codex@0.149.0
COPY agent_bundle/ /opt/agent-bundle/
COPY src/agent_entrypoint.sh /usr/local/bin/agent-entrypoint
COPY src/agent_env_launcher.mjs /usr/local/bin/agent-env-launcher.mjs
RUN chmod 0755 /usr/local/bin/agent-entrypoint && mkdir -p /home/agent && chown 1000:1000 /home/agent
USER 1000:1000
ENV HOME=/home/agent CODEX_HOME=/home/agent/.codex
WORKDIR /home/agent
ENTRYPOINT ["/usr/local/bin/agent-entrypoint"]
