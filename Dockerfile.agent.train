ARG BASE_IMAGE=task-tracker-agent:user-plugins-t8
FROM ${BASE_IMAGE}
USER 0:0
COPY agent_bundle/marketplaces/ai-marketplace/plugins/train-driver/ /opt/agent-bundle/marketplaces/ai-marketplace/plugins/train-driver/
COPY train_driver_supervisor.mjs /usr/local/bin/train-driver-supervisor.mjs
COPY train_driver_proxy.mjs /usr/local/bin/train-driver-proxy.mjs
COPY train_helper_mcp.json /opt/agent-bundle/marketplaces/ai-marketplace/plugins/train-driver/.mcp.json
COPY agent_entrypoint.sh /usr/local/bin/agent-entrypoint
COPY agent_env_launcher.mjs /usr/local/bin/agent-env-launcher.mjs
RUN chmod 0755 /usr/local/bin/agent-entrypoint
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/agent-entrypoint"]
